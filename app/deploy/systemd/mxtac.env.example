# /etc/mxtac/mxtac.env — MxTac production environment
#
# Copy this file to /etc/mxtac/mxtac.env, fill in the values, and
# restrict permissions:
#   sudo install -Dm 640 -o root -g mxtac mxtac.env.example /etc/mxtac/mxtac.env
#
# The file is loaded by the systemd unit via EnvironmentFile=.
# Lines beginning with '#' are ignored. Blank lines are ignored.
# Inline comments are NOT supported — values are taken verbatim.
#
# DO NOT commit this file with real secrets.

# ── Application ────────────────────────────────────────────────────────────────
DEBUG=false

# ── Authentication ─────────────────────────────────────────────────────────────
# Generate a strong key:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME

# Token lifetimes
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# First start only (empty users table): password of the bootstrap account
# admin@mxtac.local. It must meet the password policy or the service does not
# start. Leave empty to have a random password generated and written once to
# the service log (journalctl -u mxtac | grep 'INITIAL ADMIN PASSWORD').
# The account must set a new password at the first sign-in.
INITIAL_ADMIN_PASSWORD=

# true also creates demo accounts and invented sample data on the first start.
# Keep false on a real deployment.
SEED_DEMO_DATA=false

# ── Database ───────────────────────────────────────────────────────────────────
# PostgreSQL (default). For SQLite single-node mode set:
#   DATABASE_URL=sqlite+aiosqlite:///./data/mxtac.db
DATABASE_URL=postgresql+asyncpg://mxtac:CHANGE_ME@localhost:5432/mxtac

# ── Valkey / Redis ─────────────────────────────────────────────────────────────
VALKEY_URL=redis://localhost:6379/0

# ── Message queue ──────────────────────────────────────────────────────────────
# "memory"  — single-process, no external broker (default for standalone)
# "redis"   — Valkey Streams, required for multi-instance horizontal scaling
QUEUE_BACKEND=memory

# ── OpenSearch ─────────────────────────────────────────────────────────────────
# Events are also stored in PostgreSQL. /ready returns 503 while OpenSearch is
# not reachable, except in SQLite mode. Set the user name and password for a
# cluster with the security plugin enabled.
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_USE_SSL=false

# ── CORS ───────────────────────────────────────────────────────────────────────
# JSON array of allowed origins for browser clients (the URL the UI is served from).
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Rate limiting ──────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=300
