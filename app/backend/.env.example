# MxTac Backend — Environment Variables
# Copy to .env and fill in values before running

# ── App ───────────────────────────────────────────────
APP_NAME=MxTac API
VERSION=2.0.0
DEBUG=false

# ── Auth ──────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# First start only (empty users table): password for the bootstrap account
# admin@mxtac.local. Must meet the password policy (8-128 characters, 3 of:
# uppercase, lowercase, digits, symbols; no character 4 times in a row) or the
# server refuses to start. Leave empty to have a random password generated and
# written once to the startup log. It must be changed at first sign-in.
INITIAL_ADMIN_PASSWORD=

# ── Database ──────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://mxtac:mxtac@localhost:5432/mxtac
# Insert sample (invented) detections/connectors/rules/incidents and demo
# accounts for the analyst, hunter and engineer roles on first run.
# Demo use only — leave false on real deployments.
SEED_DEMO_DATA=false

# ── Valkey (Redis-compatible, BSD-licensed) ───────────
VALKEY_URL=redis://localhost:6379/0

# ── Queue ─────────────────────────────────────────────
# memory (default, single process) or redis (Valkey Streams)
QUEUE_BACKEND=memory

# ── OpenSearch ────────────────────────────────────────
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_USE_SSL=false

# ── Rate Limiting ─────────────────────────────────────
RATE_LIMIT_PER_MINUTE=300

# ── CORS ──────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","https://mxtac.example.com"]
